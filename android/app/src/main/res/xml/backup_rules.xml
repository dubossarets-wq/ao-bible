<?xml version="1.0" encoding="utf-8"?>
<!-- Резервная копия Android (до Android 11): только данные человека — localStorage WebView (закладки, заметки,
     проповеди, планы, настройки). Модули не копируем: они большие (лимит копии 25 МБ) и скачиваются заново. -->
<full-backup-content>
    <include domain="root" path="app_webview/Default/Local Storage/" />
</full-backup-content>
