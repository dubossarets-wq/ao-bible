{
  "name": "ao-bible",
  "version": "0.1.0",
  "private": true,
  "description": "AO Bible — веб-приложение для чтения и изучения Библии",
  "type": "module",
  "scripts": {
    "data": "python -I scripts/build_data.py && python -I scripts/build_dc.py && python -I scripts/build_places.py && python -I scripts/build_extra.py",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --dev",
    "deploy": "node scripts/release.mjs prod",
    "local-modules": "python -I scripts/build_tigran.py",
    "deploy:staging": "node scripts/release.mjs staging"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@capgo/capacitor-media-session": "^8.1.5",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "axe-core": "^4.14.0",
    "esbuild": "0.24.2",
    "playwright-core": "^1.64.1"
  }
}
